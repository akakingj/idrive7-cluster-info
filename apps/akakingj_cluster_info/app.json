{
  "id": "akakingj_cluster_info",
  "title": "AK Cluster Info",
  "description": "A small panel of up to three live values (battery power from eDrive Live, battery charge, battery, oil and coolant temperature) over the Waze map in the cluster or on the HUD, and turn signal arrows on the HUD",
  "shared": [
    "dap.js"
  ],
  "version": "1.6.14",
  "startType": "autostart",
  "vendor": "custom",
  "loggingId": "AKCI",
  "iconGlyph": "krgauge-I",
  "signals": {
    "de.bmw.dass.driverassistanceapplications.AssistedDrivingViewLateralCollisionAvoidance": {
      "_broadcasts": [
        "assistedDrivingViewLcaInput"
      ],
      "_optional": "the lane change warning (a car beside or coming up behind) on the HUD"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.body.Light": {
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusDayNightChangeOver": "rs"
    },
    "de.bmw.infotainment.personalization.SessionManager": {
      "_instances": "de.bmw.infotainment.personalization.SessionManager",
      "currentUserAccountReference": "r"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "AK Cluster Info",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "show",
      "label": "Show the panel",
      "type": "choice",
      "default": "map",
      "options": [
        [
          "map",
          "Where the Waze map is"
        ],
        [
          "hud",
          "Always on the HUD"
        ],
        [
          "off",
          "Off"
        ]
      ]
    },
    {
      "key": "place",
      "label": "Panel position",
      "type": "choice",
      "default": "bottom",
      "options": [
        [
          "bottom",
          "Bottom of the map"
        ],
        [
          "top",
          "Top of the map"
        ]
      ]
    },
    {
      "key": "slot1",
      "label": "First item",
      "type": "choice",
      "default": "boost",
      "options": [
        [
          "none",
          "Nothing"
        ],
        [
          "power",
          "Battery power (kW, from eDrive Live)"
        ],
        [
          "soc",
          "Battery charge (%)"
        ],
        [
          "battery",
          "Battery temperature"
        ],
        [
          "oil",
          "Engine oil temperature"
        ],
        [
