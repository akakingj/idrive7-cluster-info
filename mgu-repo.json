{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "--language",
        "ko",
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
    "shared": ["kit/runtime", "kit/platform", "kit/localization", "kit/tools/build.py", "kit/tools/pack_data.py", "kit/tools/localize.py", "kit/tools/locale-revisions.json", "kit/tools/oapgen", "kit/tools/make_icon.js", "oap-sdk"],
      "network": []
    }
  }
}
